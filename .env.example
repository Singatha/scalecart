# Copy to .env for local overrides. These values are development-only.
POSTGRES_USER=commerce
POSTGRES_PASSWORD=commerce_dev
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

JWT_SECRET_KEY=development-only-change-me-use-32-bytes
JWT_ISSUER=scalecart
JWT_AUDIENCE=scalecart-storefront
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=7
CART_TTL_SECONDS=2592000
MAXIMUM_ITEM_QUANTITY=99
MAXIMUM_CART_ITEMS=50
STANDARD_SHIPPING_AMOUNT=9900
EXPRESS_SHIPPING_AMOUNT=19900
FREE_SHIPPING_THRESHOLD_AMOUNT=150000
ORDER_RESERVATION_TTL_MINUTES=30
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_FIRST_NAME=Store
BOOTSTRAP_ADMIN_LAST_NAME=Administrator

REDIS_URL=redis://redis:6379/0
RABBITMQ_DEFAULT_USER=commerce
RABBITMQ_DEFAULT_PASS=commerce_dev
RABBITMQ_URL=amqp://commerce:commerce_dev@rabbitmq:5672/

LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=/api
GRAFANA_ADMIN_PASSWORD=commerce_dev
